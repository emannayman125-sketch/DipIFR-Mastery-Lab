# Copy to backend/.env and fill in real values for your environment.
# Never commit the real .env file.

# --- Core ---
DATABASE_URL=sqlite:///./dipifr.db
# SECRET_KEY must be a random value >= 32 chars in production (app refuses to start otherwise).
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Token lifetimes ---
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
RESET_TOKEN_MINUTES=30
VERIFICATION_TOKEN_HOURS=24

# --- Refresh-token cookie ---
# The refresh token is delivered as an HttpOnly cookie, never in a JSON body.
REFRESH_COOKIE_NAME=dipifr_refresh_token
COOKIE_DOMAIN=
# "lax" is correct for local dev (frontend/backend share localhost, different ports).
# Use "none" in production if the frontend and backend are on different sites
# (e.g. Vercel + a separate API host) — requires HTTPS, which is enforced
# automatically outside development/test via the cookie_secure setting.
REFRESH_COOKIE_SAMESITE=lax

# --- Rate limiting ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_TUTOR=20/hour

# --- AI (optional; falls back to keyword grading / static tutor message if unset) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Free alternative to Anthropic (no card required): https://aistudio.google.com/apikey
# Used only if ANTHROPIC_API_KEY is unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Admin (optional; /admin routes return 503 if unset) ---
ADMIN_KEY=

# --- Email delivery (required in production — validate_runtime() will refuse to start without it) ---
# Leave blank for local dev: emails are logged to the console instead of sent.
# Any standard SMTP provider works (Amazon SES, Postmark, Mailgun, Gmail/Workspace, etc.).
# If SMTP_HOST contains "sendgrid", SMTP_PASSWORD is used as a SendGrid API key
# over their HTTPS API instead of raw SMTP (bypasses PaaS SMTP-port restrictions).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
