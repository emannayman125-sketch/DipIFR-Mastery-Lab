const standardDetails: Record<string, {summary:string; rules:string[]; exam:string[]; example:string}> = {
  "IFRS 15": { summary:"IFRS 15 provides a five-step model for recognising revenue from contracts with customers.", rules:["Identify the contract and performance obligations.","Determine and allocate the transaction price.","Recognise revenue when or as performance obligations are satisfied."], exam:["Five-step model","Variable consideration","Over-time recognition"], example:"A construction service may be recognised over time when the customer controls the asset as it is created or the other over-time criteria are met." },
  "IAS 16": { summary:"IAS 16 governs recognition, measurement and subsequent accounting for property, plant and equipment.", rules:["Recognise an item when future economic benefits are probable and cost can be measured reliably.","Depreciate depreciable amount systematically over useful life.","Choose the cost or revaluation model consistently for a class of assets."], exam:["Component depreciation","Revaluation surplus","Derecognition and disposal"], example:"A machine with a significant replacement component should be depreciated by component when the components have different useful lives." },
  "IAS 23": { summary:"IAS 23 requires directly attributable borrowing costs to be capitalised when they relate to a qualifying asset.", rules:["Capitalisation starts only when expenditure, borrowing costs and qualifying activities are present.","Suspend capitalisation during extended interruptions of active development.","Stop capitalisation when substantially all activities necessary to prepare the asset are complete."], exam:["Commencement and suspension","Specific vs general borrowings","Capitalisation rate calculations"], example:"Interest on a construction loan is capitalised while active construction is taking place, but prolonged abnormal stoppages require suspension." },
  "IAS 36": { summary:"IAS 36 prevents assets from being carried above their recoverable amount.", rules:["Recoverable amount is the higher of value in use and fair value less costs of disposal.","Test goodwill and indefinite-life intangibles at least annually.","Allocate CGU impairment losses to goodwill first, then other assets subject to the standard's floors."], exam:["CGUs and goodwill","Value in use","Impairment reversals"], example:"If a CGU's recoverable amount falls below carrying amount, the loss is allocated first to goodwill allocated to that CGU." },
  "IFRS 16": { summary:"IFRS 16 requires a lessee to recognise almost all leases on the statement of financial position.", rules:["Recognise a right-of-use asset and a lease liability at commencement, measured from the present value of lease payments.","Depreciate the right-of-use asset and unwind the lease liability's discount as interest.","Short-term and low-value asset leases may be expensed instead, using the available exemptions."], exam:["Right-of-use asset and liability at commencement","Subsequent depreciation and interest","Sale and leaseback treatment"], example:"A five-year property lease with fixed annual payments is capitalised at the present value of those payments, discounted at the rate implicit in the lease or the lessee's incremental borrowing rate." },
  "IAS 38": { summary:"IAS 38 distinguishes research expenditure from development expenditure and sets recognition criteria for internally generated intangibles.", rules:["Research expenditure is expensed as incurred.","Development expenditure is capitalised only when all recognition criteria are demonstrated.","Amortise finite-life intangibles systematically over their useful lives."], exam:["Research vs development","Recognition criteria","Useful life and amortisation"], example:"A project moves from research to development only when technical feasibility, intention, resources and reliable measurement can be demonstrated." },
  "IFRS 3": { summary:"IFRS 3 sets out the acquisition method for recognising and measuring a business combination.", rules:["Identify the acquirer and the acquisition date.","Measure identifiable assets acquired and liabilities assumed at fair value.","Goodwill is the excess of consideration transferred (plus NCI and any previously held interest) over net identifiable assets acquired at fair value."], exam:["Goodwill calculation","Contingent consideration","Bargain purchase gains"], example:"Consideration that includes contingent cash payable on future performance is included in goodwill at its acquisition-date fair value, with later remeasurement usually going through profit or loss." },
  "IAS 2": { summary:"IAS 2 requires inventories to be measured at the lower of cost and net realisable value.", rules:["Cost includes purchase cost plus costs of conversion and other costs to bring inventory to its present location and condition.","Net realisable value is estimated selling price less estimated costs to complete and sell.","Write-downs are expensed and may be reversed (up to original cost) if NRV later recovers."], exam:["Lower of cost and NRV","Cost formulas (FIFO/weighted average)","Write-downs and reversals"], example:"Stock that needs further rework and incurs extra costs before sale is written down to net realisable value after deducting those completion and selling costs." },
  "IFRS 9": { summary:"IFRS 9 covers classification, measurement and impairment of financial instruments.", rules:["Financial-asset classification depends on business model and contractual cash-flow characteristics.","Amortised cost requires the hold-to-collect model and SPPI cash flows.","The ECL model recognises expected rather than only incurred credit losses."], exam:["SPPI and business models","ECL staging","FVTPL/FVOCI/amortised cost"], example:"A debt instrument held both to collect cash flows and to sell may qualify for FVOCI if the contractual cash flows meet SPPI." },
  "IAS 32": { summary:"IAS 32 sets out the principles for classifying financial instruments as liabilities or equity, based on the substance of the contractual arrangement.", rules:["A financial liability exists where there is a contractual obligation to deliver cash or another financial asset.","An instrument is equity only where it evidences a residual interest with no such obligation.","Compound instruments (e.g. convertible bonds) are split into separate liability and equity components."], exam:["Liability vs equity classification","Split accounting for compound instruments","Offsetting criteria"], example:"A convertible bond is split at issue into a liability component (present value of cash flows at a market rate) and an equity component (the residual)." },
  "IAS 37": { summary:"IAS 37 sets recognition criteria for provisions and distinguishes them from contingent liabilities and contingent assets.", rules:["Recognise a provision only where there is a present obligation from a past event, a probable outflow, and a reliable estimate.","Contingent liabilities are disclosed, not recognised, unless outflow is remote.","Restructuring provisions require a detailed formal plan and a valid expectation raised in those affected, and exclude costs associated with ongoing activities."], exam:["Recognition criteria","Discounting a long-term provision","Restructuring cost restrictions"], example:"A restructuring announcement with a detailed plan and public commitment creates a constructive obligation, but costs of retraining continuing staff are excluded from the provision." },
  "IAS 19": { summary:"IAS 19 covers recognition and measurement of employee benefits, most notably defined benefit pension plans.", rules:["Short-term and defined contribution benefits are expensed as the related service is rendered.","A defined benefit obligation is measured using the projected unit credit method.","Service cost and net interest go to profit or loss; remeasurements go to other comprehensive income and are never reclassified."], exam:["Defined benefit roll-forward","Splitting P&L vs OCI components","Net interest calculation"], example:"An actuarial remeasurement loss on the pension obligation is recognised in OCI, while the current service cost for the year is charged to profit or loss." },
  "IAS 12": { summary:"IAS 12 requires recognition of current and deferred tax based on temporary differences between an asset or liability's carrying amount and its tax base.", rules:["Current tax is the amount expected to be paid to or recovered from tax authorities for the period.","A taxable temporary difference (carrying amount exceeds tax base) generally gives rise to a deferred tax liability.","A deductible temporary difference generally gives rise to a deferred tax asset, subject to recoverability."], exam:["Temporary difference identification","Deferred tax on revaluations","Recognition of deferred tax assets"], example:"An asset revalued above its tax base creates a taxable temporary difference, and the resulting deferred tax liability is recognised in other comprehensive income alongside the revaluation surplus." },
  "IAS 21": { summary:"IAS 21 governs how transactions in a foreign currency and foreign operations are translated into an entity's functional currency.", rules:["Monetary items are retranslated at the closing rate at each reporting date.","Non-monetary items measured at historical cost are not retranslated.","Exchange differences on monetary items are generally recognised in profit or loss."], exam:["Functional currency determination","Retranslation of monetary items","Exchange differences on settlement"], example:"A foreign-currency trade receivable is retranslated at the closing rate at each year end, with the resulting exchange gain or loss taken to profit or loss." },
  "IAS 41": { summary:"IAS 41 requires biological assets to generally be measured at fair value less costs to sell, with changes recognised in profit or loss.", rules:["Biological assets are measured at fair value less costs to sell both at initial recognition and each reporting date, unless fair value cannot be reliably measured.","Agricultural produce harvested from biological assets is measured at fair value less costs to sell at the point of harvest.","Government grants related to biological assets measured at fair value are recognised in profit or loss when the grant becomes receivable."], exam:["Fair value less costs to sell","Produce at point of harvest","Interaction with government grants"], example:"A herd of dairy cattle is remeasured to fair value less costs to sell at each year end, with the movement recognised directly in profit or loss." },
  "IFRS 2": { summary:"IFRS 2 requires an expense to be recognised for goods or services received in a share-based payment transaction, measured by reference to fair value.", rules:["Equity-settled transactions are measured at the grant-date fair value of the equity instruments, which is not subsequently remeasured.","Cash-settled transactions are remeasured to fair value at each reporting date until settlement.","The expense is spread over the vesting period, adjusted for the number of instruments expected to vest."], exam:["Equity-settled expense calculation","Revising leaver estimates mid-vesting","Treatment on lapse after vesting"], example:"An expense for share options is calculated using the number of employees expected to still be employed at vesting, updated each year as estimates change, but grant-date fair value itself is never revised." },
  "IFRS 6": { summary:"IFRS 6 gives limited relief allowing entities to continue their previous accounting policies for exploration and evaluation expenditure.", rules:["E&E expenditure applies only after the legal right to explore a specific area has been obtained.","Entities may choose to capitalise or expense E&E expenditure as an accounting policy, applied consistently.","E&E assets are assessed for impairment when facts and circumstances suggest the carrying amount may exceed recoverable amount."], exam:["Scope boundary (legal right obtained)","Policy choice on capitalisation","Impairment indicators specific to E&E"], example:"Costs incurred searching for minerals before the legal exploration right is granted fall outside IFRS 6's scope and cannot be capitalised under it." },
  "IFRS 13": { summary:"IFRS 13 defines fair value as an exit price and sets out a single framework for fair value measurement and disclosure.", rules:["Fair value is the price that would be received to sell an asset (or paid to transfer a liability) in an orderly transaction between market participants at the measurement date.","Measurement uses the asset's principal (or most advantageous) market and its highest and best use.","Inputs are ranked in a three-level hierarchy, with Level 1 (quoted prices for identical items) given the highest priority."], exam:["Fair value hierarchy (Levels 1-3)","Principal vs most advantageous market","Choosing between competing valuation inputs"], example:"When a quoted price exists in an active market for an identical asset, that Level 1 input must be used in preference to an internally generated valuation model." },
  "IFRS 18": { summary:"IFRS 18 restructures the statement of profit or loss into defined categories and introduces new mandatory subtotals and disclosures.", rules:["Income and expenses are classified into five categories: operating, investing, financing, income tax and discontinued operations.","Two new subtotals are required: operating profit, and profit before financing and income tax.","Management-defined performance measures used in public communications must be disclosed in a single note with a reconciliation to the nearest IFRS subtotal."], exam:["The five income statement categories","New mandatory subtotals","Management-defined performance measure disclosure"], example:"An 'adjusted profit' figure a company publicises in its press releases must now be reconciled, in the notes, to the closest IFRS-defined subtotal." },
  "IAS 33": { summary:"IAS 33 sets out the calculation of basic and diluted earnings per share for entities with publicly traded shares.", rules:["Basic EPS is profit attributable to ordinary equity holders divided by the weighted average number of ordinary shares outstanding.","A bonus issue is treated as if it had always been in issue, adjusting all periods presented.","Diluted EPS reflects the dilutive effect of potential ordinary shares, such as options, using the treasury stock method."], exam:["Basic EPS with a mid-year share issue","Bonus issue and rights issue adjustments","Treasury stock method for options"], example:"Outstanding share options are treated as diluting EPS by the 'shares issued for no consideration' — the difference between shares issued on exercise and shares that could be repurchased with the proceeds at market price." },
  "IAS 10": { summary:"IAS 10 distinguishes adjusting from non-adjusting events occurring between the reporting date and the date financial statements are authorised for issue.", rules:["Adjusting events provide evidence of conditions that existed at the reporting date, and the financial statements are adjusted accordingly.","Non-adjusting events relate to conditions arising after the reporting date and are disclosed if material, not adjusted for.","An entity cannot prepare financial statements on a going concern basis if events after the reporting date indicate this is no longer appropriate."], exam:["Adjusting vs non-adjusting classification","Going concern deterioration after year end","Required disclosure content"], example:"A customer's insolvency shortly after year end, where the customer was already in financial difficulty at year end, is an adjusting event requiring the receivable to be written down." },
  "IAS 8": { summary:"IAS 8 sets out how to select accounting policies and how to treat changes in policy, changes in estimate, and prior period errors.", rules:["Accounting policies are applied consistently and changed only if required by a standard or if the change gives more reliable and relevant information.","A change in accounting estimate is applied prospectively, from the period of change onward.","A material prior period error is corrected retrospectively, restating opening balances and comparatives, not through current period profit or loss."], exam:["Distinguishing a policy change from an estimate change","Retrospective restatement mechanics","Required error disclosures"], example:"Discovering a data-entry error that overstated a prior year's asset is a prior period error, corrected by restating the comparative figures, not by adjusting the current year's profit." },
  "IAS 24": { summary:"IAS 24 requires disclosure of relationships, transactions and outstanding balances with related parties, to alert users to the possibility that results have been affected by such relationships.", rules:["A related party includes entities and individuals with control, joint control or significant influence over the reporting entity, and key management personnel.","Related party relationships must be disclosed even where there have been no transactions.","Material related party transactions and balances are disclosed with enough detail for users to understand their effect."], exam:["Identifying who counts as a related party","Key management personnel compensation disclosure","Materiality of related party transactions"], example:"A sale of goods to a director's close family member's company is a related party transaction requiring disclosure, regardless of whether it was priced at arm's length." },
  "IFRS 8": { summary:"IFRS 8 requires disclosure of information about an entity's operating segments, based on the components regularly reviewed by the chief operating decision maker.", rules:["Operating segments are identified based on internal management reporting to the CODM, not by geography or product alone.","A segment is reportable if it meets any of the 10% thresholds for revenue, profit or assets.","Segments not individually meeting a threshold may still be disclosed voluntarily or combined into an 'all other segments' category."], exam:["Identifying the CODM and operating segments","Applying the 10% quantitative thresholds","Aggregation criteria for similar segments"], example:"A division representing 12% of total combined revenue is a reportable segment under IFRS 8 even if its profit and assets each fall below their own 10% thresholds." },
  "IFRS for SMEs": { summary:"The IFRS for SMEs Standard is a self-contained, simplified set of recognition, measurement and disclosure requirements for entities without public accountability.", rules:["Eligibility requires no public accountability (no publicly traded instruments, and no fiduciary holding of assets for a broad group of outsiders as a primary business).","Recognition and measurement are simplified compared with full IFRS, not just disclosure — for example, development costs and borrowing costs are always expensed.","Disclosure requirements are substantially reduced relative to full IFRS Accounting Standards."], exam:["Eligibility criteria","Simplified treatment of development and borrowing costs","How this differs from IFRS 19's reduced-disclosure-only approach"], example:"A private manufacturer with no parent company and no public debt or equity may adopt the IFRS for SMEs Standard and expense all its development costs, rather than assessing IAS 38's capitalisation criteria." },
  "IFRS 19": { summary:"IFRS 19 allows an eligible subsidiary to apply reduced disclosure requirements while still using full IFRS recognition and measurement.", rules:["Eligibility requires no public accountability and an ultimate or intermediate parent that produces IFRS-compliant consolidated financial statements available for public use.","IFRS 19 changes disclosure only; recognition and measurement remain identical to full IFRS Accounting Standards.","Eligibility is lost if the qualifying parent stops preparing such consolidated financial statements."], exam:["Eligibility criteria for a subsidiary","Disclosure-only nature of the reduction","Contrast with the IFRS for SMEs Standard"], example:"A wholly owned subsidiary of a listed group can apply IFRS 19 to slim down its own separate financial statements' notes, while still recognising and measuring everything exactly as required under full IFRS." },
  "IFRS S1": { summary:"IFRS S1 sets the general requirements for an entity to disclose sustainability-related risks and opportunities relevant to its prospects.", rules:["Disclosures should enable users to assess effects on the entity's cash flows, access to finance or cost of capital over the short, medium and long term.","Disclosures are organised around four content areas: governance, strategy, risk management, and metrics and targets.","Connectivity is required between sustainability-related disclosures and the related financial statements."], exam:["The four content areas","Materiality of sustainability information","Connectivity to the financial statements"], example:"A company must disclose the governance processes it uses to oversee a sustainability-related risk, not just describe the risk itself in isolation." },
  "IFRS S2": { summary:"IFRS S2 applies IFRS S1's framework specifically to climate-related risks and opportunities.", rules:["Uses the same four content areas as IFRS S1 (governance, strategy, risk management, metrics and targets), applied to climate matters.","Requires disclosure of exposure to climate-related physical and transition risks.","Requires disclosure of greenhouse gas emissions, generally using the Greenhouse Gas Protocol."], exam:["Physical vs transition climate risks","Greenhouse gas emissions disclosure","Climate-related targets"], example:"An entity discloses its Scope 1, 2 and (where required) Scope 3 greenhouse gas emissions as part of its IFRS S2 metrics and targets disclosures." },
  "IAS 20": { summary:"IAS 20 covers accounting for government grants and disclosure of government assistance.", rules:["Recognise grants only when there is reasonable assurance of compliance and receipt.","Asset-related grants may be presented as deferred income or deducted from the asset's carrying amount.","Income-related grants are recognised systematically over the periods of the related costs."], exam:["Asset-related grants","Income-related grants","Presentation and timing"], example:"A grant for purchasing equipment can be deferred and released over the asset's useful life, or deducted from the asset's carrying amount." },
  "IAS 40": { summary:"IAS 40 covers property held to earn rentals or for capital appreciation, distinct from owner-occupied property under IAS 16.", rules:["Investment property is property held to earn rentals or for capital appreciation, not for use in production/administration or sale in the ordinary course of business.","Under the fair value model, the property is remeasured each period with no depreciation charged, and gains or losses go to profit or loss.","A change in use requires transfer to/from investment property, measured at fair value at the date of the change under the fair value model."], exam:["Classification vs owner-occupied PPE","Fair value model mechanics","Transfers between categories"], example:"A building leased entirely to a third party for rental income is investment property, remeasured to fair value each year with the movement recognised in profit or loss." },
  "IFRS 5": { summary:"IFRS 5 sets classification, measurement and presentation requirements for assets held for sale and discontinued operations.", rules:["Classification as held for sale requires the asset to be available for immediate sale in its present condition and the sale to be highly probable.","Once classified, the asset (or disposal group) is measured at the lower of carrying amount and fair value less costs to sell, and depreciation ceases.","A discontinued operation is presented as a single amount in profit or loss, separate from continuing operations."], exam:["Held-for-sale classification criteria","Measurement and depreciation cessation","Discontinued operations presentation"], example:"Once a division meets all held-for-sale criteria, its assets stop being depreciated and are written down to fair value less costs to sell if that is lower than carrying amount." },
  "IFRS 10": { summary:"IFRS 10 defines control as the basis for consolidation and sets out the mechanics of preparing consolidated financial statements.", rules:["Control requires power over the investee, exposure or rights to variable returns, and the ability to use power to affect those returns.","Consolidated financial statements combine the parent and subsidiaries' assets, liabilities, income and expenses line by line.","Intragroup balances, transactions, income and expenses are eliminated in full on consolidation."], exam:["Assessing control (including potential voting rights)","Non-controlling interest calculation","Intragroup elimination adjustments"], example:"A parent holding 55% of voting rights, with no other party able to direct the subsidiary's relevant activities, controls the subsidiary and must consolidate it in full, with NCI recognised for the remaining 45%." },
  "IAS 28": { summary:"IAS 28 requires investments where an investor has significant influence to be accounted for using the equity method.", rules:["Significant influence is presumed at 20% or more of voting power, unless clearly rebutted by the facts.","Under the equity method, the investment is initially recognised at cost and subsequently adjusted for the investor's share of the associate's post-acquisition profit or loss and OCI.","Unrealised profits on transactions between the investor and associate are eliminated to the extent of the investor's interest."], exam:["Significant influence presumption","Equity method roll-forward","Upstream/downstream transaction eliminations"], example:"A 30% shareholding is presumed to give significant influence, so the investment is equity-accounted rather than treated as a simple financial asset." },
  "IFRS 11": { summary:"IFRS 11 classifies joint arrangements as either joint operations or joint ventures based on the parties' rights and obligations, not just the legal structure.", rules:["A joint operation gives the parties rights to the arrangement's assets and obligations for its liabilities.","A joint venture gives the parties rights only to the arrangement's net assets.","Joint operators recognise their own share of assets, liabilities, revenue and expenses directly; joint venturers use the equity method."], exam:["Joint operation vs joint venture classification","Accounting treatment for each type","Role of the contractual terms over legal form"], example:"Even where a joint arrangement is structured through a separate legal vehicle, the parties' contractual rights to the underlying assets and obligations for liabilities can still make it a joint operation rather than a joint venture." },
  "IAS 1": { summary:"IAS 1 establishes the overall presentation and disclosure framework for financial statements.", rules:["Assess going concern and disclose material uncertainties.","Present material items separately and avoid obscuring useful information.","Apply consistent presentation and classification unless a justified change is required."], exam:["Materiality and aggregation","Going concern","Current/non-current presentation"], example:"A covenant breach may create a current-liability issue and a going-concern disclosure question depending on the facts." },
  "FRAMEWORK-ETHICS": { summary:"The Conceptual Framework underpins the IASB's standard-setting and helps preparers when no standard specifically applies; professional ethics govern how preparers should respond to pressure to misstate results.", rules:["The fundamental qualitative characteristics of useful information are relevance and faithful representation, enhanced by comparability, verifiability, timeliness and understandability.","The Conceptual Framework is not itself an IFRS Accounting Standard and never overrides a specific standard's requirements.","When facing pressure to apply a non-compliant treatment, a preparer should apply safeguards such as raising the issue, documenting the position, and escalating to those charged with governance rather than complying."], exam:["Qualitative characteristics of useful information","Role and status of the Conceptual Framework","Ethical response to management pressure"], example:"A finance director asking for revenue to be recognised early to meet a profit forecast raises a threat to integrity and objectivity that should be escalated, not accommodated." },
};

function KnowledgeBase() {
  const [q,setQ]=useState("");
  const [selected,setSelected]=useState("IAS 16");
  const results=standards.filter(s=>`${s.code} ${s.title} ${s.topics.join(" ")}`.toLowerCase().includes(q.toLowerCase()));
  const detail=standardDetails[selected] || standardDetails["IAS 16"];
  return <div className="stack">
    <div className="panel"><span className="pill">REFERENCE LIBRARY</span><h2>Understand the rule. Then apply it.</h2><p className="lead">Concise exam-focused notes, common traps and worked scenarios. Always verify final technical conclusions against the current official IFRS/IAS literature.</p><input className="search" value={q} onChange={e=>setQ(e.target.value)} placeholder="Search IAS 16, impairment, grants..." /></div>
    <div className="cardGrid">{results.map(s=><article className={selected===s.code?"card selectedCard":"card"} key={s.code} onClick={()=>setSelected(s.code)}><div className="cardTop"><span className="code">{s.code}</span><span className="mini">{s.topics.length} core topics</span></div><h3>{s.title}</h3><p>{s.topics.join(" · ")}</p><button className="link" onClick={()=>setSelected(s.code)}>Open standard →</button></article>)}</div>
    <section className="panel standardDetail"><div className="cardTop"><span className="code">{selected}</span><span className="pill">EXAM FOCUS</span></div><h2>{standards.find(s=>s.code===selected)?.title}</h2><p className="lead">{detail.summary}</p><div className="detailGrid"><div><h3>Key rules</h3><ul>{detail.rules.map(x=><li key={x}>{x}</li>)}</ul></div><div><h3>What to practise</h3><ul>{detail.exam.map(x=><li key={x}>{x}</li>)}</ul></div></div><div className="exampleBox"><b>Exam scenario</b><p>{detail.example}</p></div></section>
  </div>
}

// ---------------------------------------------------------------------------
// AI Tutor: real backend call, server-side API key
// ---------------------------------------------------------------------------
function Tutor({ initialQuestionContext }: { initialQuestionContext?: string } = {}) {
  const [message,setMessage]=useState("");
  const [thread,setThread]=useState<{role:"user"|"assistant";content:string}[]>([]);
  const [asking,setAsking]=useState(false);
  const [error,setError]=useState<string|null>(null);
  const questionContext = initialQuestionContext;

  const ask = async () => {
    if (!message.trim()) return;
    setAsking(true);
    setError(null);
    const userText = message.trim();
    setMessage("");
    try {
      const res = await api.askTutor(userText, thread, questionContext);
      setThread(prev => [...prev, { role: "user", content: userText }, { role: "assistant", content: res.reply }]);
    } catch {
      setError("Could not reach the tutor. Please try again.");
    } finally {
      setAsking(false);
    }
  };

  return <div className="stack"><div className="panel">
    <span className="pill">AI TUTOR</span>
    <h2>Learn from your questions—not from shortcuts.</h2>
    <p>Ask for an explanation, compare two standards, or request feedback on an exam-style answer. Follow-up questions remember the conversation.</p>
    {questionContext && <div className="sourceTag">Talking about your current question</div>}
    {thread.length > 0 && (
      <div className="tutorThread">
        {thread.map((m,i) => (
          <div key={i} className={m.role==="user" ? "tutorMsg user" : "tutorMsg assistant"}>
            <b>{m.role==="user" ? "You" : "Tutor"}</b>
            <p>{m.content}</p>
          </div>
        ))}
      </div>
    )}
    <textarea value={message} onChange={e=>setMessage(e.target.value)} placeholder="e.g. Compare IAS 23 and IAS 16 in a construction scenario..." />
    {error && <div className="inlineError">{error}</div>}
    <button className="primary" onClick={ask} disabled={asking || !message.trim()}>{asking?"Thinking…":"Ask Tutor"}</button>
  </div></div>
}
